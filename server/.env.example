# Copy this file to ".env" and fill in the values.

# Port the local server listens on
PORT=8787

# Secret used to encrypt your API keys on disk (AES-256-GCM, key derived with scrypt).
# Generate a long random one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PANEL_SECRET=change-me-to-something-long-and-random

# Optional token required when the UI connects (protection if you expose the port).
# Leave empty for strictly local use (localhost).
PANEL_TOKEN=

# Network interface to listen on. Default 127.0.0.1 = only this machine can reach
# the panel. Do NOT set 0.0.0.0 unless it sits behind a VPN/reverse proxy + PANEL_TOKEN.
# HOST=127.0.0.1

# Extra browser origins allowed to open the trading WebSocket (comma-separated),
# e.g. a reverse proxy: https://panel.example.com. Pages on localhost are always allowed;
# every other website is rejected, so a malicious page can't place orders.
# ALLOWED_ORIGINS=
